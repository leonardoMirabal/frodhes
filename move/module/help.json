      "title": "MIDI",
      "lines": [
        "Notes with velocity",
        "and release",
        "velocity, pitch bend",
        "(piano types),",
        "sustain CC 64 with",
        "half pedal, program",
        "change 0-15 F01-F16,",
        "16-31 U01-U16, 32-34",
        "F17-F19, MIDI clock.",
        "Every parameter has",
