# cmake -DROOT=<repo> -DOUT=<dir>/frp_git.h -P git_rev.cmake: FRP_GIT, the commit a dev build shows in the window's
# VERSION ("DEV" and its first 4 hex digits, as the FM-1: tools/build.py app_git). $APP_GIT first, else
# `git rev-parse --short=7 HEAD` in ROOT, else nothing (a tree without git, e.g. inside a container). Run at every
# build; the file is rewritten only when the text changes, so an unchanged commit rebuilds nothing.
set(g "$ENV{APP_GIT}")
if(NOT DEFINED ENV{APP_GIT})
    find_program(FRP_GIT_EXE git)
    if(FRP_GIT_EXE)
        execute_process(COMMAND "${FRP_GIT_EXE}" rev-parse --short=7 HEAD WORKING_DIRECTORY "${ROOT}"
                        OUTPUT_VARIABLE g OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET RESULT_VARIABLE rc)
        if(NOT rc EQUAL 0)
            set(g "")
        endif()
    endif()
endif()
if(NOT g MATCHES "^[0-9a-f][0-9a-f][0-9a-f][0-9a-f]+$")
    set(g "")
endif()
set(text "/* generated by plugin/cmake/git_rev.cmake at every build */\n#define FRP_GIT \"${g}\"\n")
if(EXISTS "${OUT}")
    file(READ "${OUT}" old)
endif()
if(NOT old STREQUAL text)
    file(WRITE "${OUT}" "${text}")
endif()
