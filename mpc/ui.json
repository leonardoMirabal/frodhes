{
  "kit": "mono",
  "pages": [
    { "name": "SOUND", "controls": [
      { "param": "Type", "widget": "slider", "overlay": "menu" },
      { "param": "Tone / strike", "widget": "knob", "polarity": "bipolar" },
      { "param": "Bell / tube", "widget": "knob" },
      { "param": "Velocity response", "widget": "switch" } ] },
    { "name": "VOICE", "controls": [
      { "param": "Bark / mallet", "widget": "knob" },
      { "param": "Hammer / weight", "widget": "knob" },
      { "param": "Decay / ring", "widget": "knob" },
      { "param": "Release / damper", "widget": "knob" } ] },
    { "name": "VOICE 2", "controls": [
      { "param": "Noise", "widget": "knob" },
      { "param": "Stereo spread", "widget": "knob" },
      { "param": "Tune", "widget": "knob", "polarity": "bipolar" },
      { "param": "Level", "widget": "knob", "polarity": "bipolar" } ] },
    { "name": "MOTOR", "controls": [
      { "param": "Motor", "widget": "switch" },
      { "param": "Motor depth", "widget": "knob" },
      { "param": "Motor speed", "widget": "knob" },
      { "param": "Motor shape", "widget": "knob" } ] },
    { "name": "COMP", "controls": [
      { "param": "Compressor", "widget": "switch" },
      { "param": "Compressor threshold", "widget": "knob" },
      { "param": "Compressor ratio", "widget": "slider", "overlay": "menu" },
      { "param": "Compressor make-up", "widget": "knob" } ] },
    { "name": "COMP 2", "controls": [
      { "param": "Compressor attack", "widget": "knob" },
      { "param": "Compressor release", "widget": "knob" },
      "empty",
      "empty" ] },
    { "name": "EQ", "controls": [
      { "param": "EQ low", "widget": "knob", "polarity": "bipolar" },
      { "param": "EQ mid", "widget": "knob", "polarity": "bipolar" },
      { "param": "EQ mid frequency", "widget": "knob" },
      { "param": "EQ high", "widget": "knob", "polarity": "bipolar" } ] },
    { "name": "DRIVE", "controls": [
      { "param": "Drive type", "widget": "slider", "overlay": "menu" },
      { "param": "Drive amount", "widget": "knob" },
      { "param": "Drive tone", "widget": "knob", "polarity": "bipolar" },
      { "param": "Drive mix", "widget": "knob" } ] },
    { "name": "FILTER", "controls": [
      { "param": "Filter type", "widget": "slider", "overlay": "menu" },
      { "param": "Filter cutoff", "widget": "knob" },
      { "param": "Filter resonance", "widget": "knob" },
      { "param": "Filter LFO amount", "widget": "knob" } ] },
    { "name": "FLT LFO", "controls": [
      { "param": "Filter LFO shape", "widget": "slider", "overlay": "menu" },
      { "param": "Filter LFO rate", "widget": "knob" },
      { "param": "Filter LFO sync", "widget": "slider", "overlay": "menu" },
      { "param": "Filter LFO retrigger", "widget": "switch" } ] },
    { "name": "TREM", "controls": [
      { "param": "Tremolo / wah", "widget": "switch" },
      { "param": "Tremolo depth", "widget": "knob" },
      { "param": "Tremolo rate", "widget": "knob" },
      { "param": "Tremolo shape", "widget": "knob" } ] },
    { "name": "PHASER", "controls": [
      { "param": "Phaser", "widget": "switch" },
      { "param": "Phaser depth", "widget": "knob" },
      { "param": "Phaser speed", "widget": "knob" },
      { "param": "Phaser feedback", "widget": "knob" } ] },
    { "name": "CHORUS", "controls": [
      { "param": "Chorus", "widget": "switch" },
      { "param": "Chorus depth", "widget": "knob" },
      { "param": "Chorus speed", "widget": "knob" },
      { "param": "Chorus feedback", "widget": "knob" } ] },
    { "name": "DELAY", "controls": [
      { "param": "Delay type", "widget": "switch" },
      { "param": "Delay mix", "widget": "knob" },
      { "param": "Delay time", "widget": "knob" },
      { "param": "Delay feedback", "widget": "knob" } ] },
    { "name": "SYNC", "controls": [
      { "param": "Tremolo sync", "widget": "slider", "overlay": "menu" },
      { "param": "Phaser sync", "widget": "slider", "overlay": "menu" },
      { "param": "Chorus sync", "widget": "slider", "overlay": "menu" },
      { "param": "Delay sync", "widget": "slider", "overlay": "menu" } ] },
    { "name": "REVERB", "controls": [
      { "param": "Reverb type", "widget": "switch" },
      { "param": "Reverb mix", "widget": "knob" },
      { "param": "Reverb decay", "widget": "knob" },
      { "param": "Reverb tone", "widget": "knob", "polarity": "bipolar" } ] },
    { "name": "REVERB 2", "controls": [
      { "param": "Reverb pre-delay", "widget": "knob" },
      { "param": "Reverb size", "widget": "knob" },
      { "param": "Reverb modulation", "widget": "knob" },
      { "param": "Reverb low cut", "widget": "knob" } ] },
    { "name": "PLAY", "controls": [
      { "param": "Preset", "widget": "slider", "overlay": "menu" },
      { "param": "Sustain", "widget": "switch" },
      { "param": "Effects bypass", "widget": "switch" },
      "empty" ] },
    { "name": "MORE", "controls": [
      { "param": "Tremolo mode", "widget": "switch" },
      { "param": "Motor sync", "widget": "slider", "overlay": "menu" },
      { "param": "Delay tone", "widget": "knob" },
      "empty" ] }
  ]
}
